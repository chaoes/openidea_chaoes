package openidea:plugin@1.7.0;

/// Problems in files, shown in the editor and the Problems view.
interface diagnostics {
    use types.{error, range, location};

    enum severity {
        error,
        warning,
        info,
        hint,
    }

    /// Another place that explains a diagnostic (the earlier declaration, say).
    record related-information {
        location: location,
        message: string,
    }

    record diagnostic {
        range: range,
        severity: severity,
        message: string,
        /// Rule or check id (`LineLength`).
        code: option<string>,
        /// The tool that found it, when not the plugin itself (`checkstyle`).
        source: option<string>,
        /// `unnecessary` (shown faded) and `deprecated` (struck through); unknown ones are ignored.
        tags: list<string>,
        related: list<related-information>,
    }

    /// Replaces the plugin's diagnostics for the file at `path` (absolute, in
    /// an open project); an empty list clears them. Requires `project.read`.
    publish: func(path: string, diagnostics: list<diagnostic>) -> result<_, error>;
}

/// HTTP(S) to the hosts granted with `net:<host>`.
interface net {
    use types.{error};

    record header {
        name: string,
        value: string,
    }

    record request {
        method: string,
        /// `https://…`; plain `http://` only to `localhost` / `127.0.0.1`.
        url: string,
        /// `{{secret:<name>}}` in a value is replaced by the plugin's secret
        /// `name` on the way out (requires `secrets`); the plugin never sees it.
        headers: list<header>,
        body: option<list<u8>>,
        /// Default 30 s; the call's own budget applies too.
        timeout-ms: option<u32>,
    }

    record response {
        status: u16,
        headers: list<header>,
        /// At most 8 MiB.
        body: list<u8>,
    }

    /// Fails with `denied` for a host the plugin may not reach, `cancelled`
    /// when a newer request replaced the call or the user cancelled.
    fetch: func(req: request) -> result<response, error>;
}

/// Secrets the user stored for the plugin (Settings › Plugins, kept in the
/// OS keychain). Plugins only use them through `{{secret:<name>}}` in
/// `net` requests. Requires `secrets`.
interface secrets {
    is-set: func(name: string) -> bool;
}

/// Runs programs granted with `process:<program>` (the file the user approved,
/// checked before every run): once and waited for with `run` / `run-command`,
/// or kept running behind a handle with `start`.
interface process {
    use types.{error};
    use workspace.{project};

    record output {
        /// `none` when killed by a signal.
        status: option<s32>,
        /// At most 4 MiB each (the rest is dropped).
        stdout: string,
        stderr: string,
    }

    /// What to run and with which environment; where it runs is the `cwd`
    /// argument of `run-command` / `start`.
    record command {
        program: string,
        args: list<string>,
        /// Variables added to the inherited environment (the rest of it, `PATH`
        /// among them, still applies). At most 64 entries, names at most 256
        /// bytes, values 4 KiB. Neither may contain a NUL, and a name may not
        /// contain `=`. A different `PATH` can point a bare program name at
        /// another file, which is why the approved file is what runs, not the
        /// name.
        env: list<tuple<string, string>>,
    }

    /// What the program of a handle printed since the last `poll` / `wait`.
    record chunk {
        /// At most `max-bytes` of each (the rest stays for the next call). A
        /// `max-bytes` of 0 still hands over one byte rather than nothing, so a
        /// polling loop always makes progress.
        stdout: string,
        stderr: string,
        /// Its exit status once it ended, else none.
        status: option<s32>,
    }

    /// Runs `program` with `args` in `cwd`'s root (else the plugin's data
    /// directory) and waits; cancelled with the task or call. Call it inside
    /// a task for anything slow. `run-command` is the same for a `command`,
    /// which also carries environment variables.
    run: func(program: string, args: list<string>, cwd: option<borrow<project>>, stdin: option<string>) -> result<output, error>;

    /// Runs `cmd`, writes `stdin` to it if given, and waits for it to end.
    run-command: func(cmd: command, cwd: option<borrow<project>>, stdin: option<string>) -> result<output, error>;

    /// Starts `cmd` and returns a handle without waiting, for programs that
    /// serve requests, watch files or wait for input: `write` feeds the input,
    /// `poll` reads what it printed, `kill` ends it. At most 8 handles per
    /// plugin (the next `start` fails with `invalid`). Handles end with the
    /// plugin's instance: when it stops, is disabled or is reclaimed while
    /// idle, its running programs are killed and the handles are gone.
    start: func(cmd: command, cwd: option<borrow<project>>) -> result<u64, error>;

    /// Reads what the program of `id` printed since the last call, and its
    /// exit status once it ended. Does not block.
    poll: func(id: u64, max-bytes: u32) -> result<chunk, error>;

    /// Writes `text` to its stdin; `invalid` once it ended or its input was
    /// closed.
    write: func(id: u64, text: string) -> result<_, error>;

    /// Ends its input, so the program sees end of file.
    close-stdin: func(id: u64) -> result<_, error>;

    /// Ends it (and its children where the platform allows) but keeps the
    /// handle, so `poll` / `wait` still report what it printed and how it ended.
    kill: func(id: u64) -> result<_, error>;

    /// Waits up to `timeout-ms` (0: only check) for it to end, and reads what
    /// it printed; `status` is none while it still runs. `cancelled` with the
    /// task or call.
    wait: func(id: u64, timeout-ms: u32) -> result<chunk, error>;

    /// Forgets the handle, killing the program if it still runs.
    release: func(id: u64) -> result<_, error>;
}
